# 首次初始化时创建管理员账号；之后登录密码以 MySQL 中的密码哈希为准。
AUTH_USERNAME=wolfowner
AUTH_PASSWORD=replace-with-your-password
AUTH_SECURE_COOKIE=false

# 复制到 .env.mysql 并生成独立密码；MySQL 容器仅开放电脑本机端口。
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=werewolf_members
DB_USER=werewolf_app
DB_PASSWORD=replace-with-a-random-password
DB_ROOT_PASSWORD=replace-with-a-different-random-password
